{
  "name": "deluno-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/web",
    "sdk/typescript"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "test:web": "npm --workspace apps/web run test:unit && npm --workspace apps/web run test:smoke",
    "test:unit:web": "npm --workspace apps/web run test:unit",
    "test:unit:web:coverage": "npm --workspace apps/web run test:unit:coverage",
    "typecheck:sdk": "npm --workspace sdk/typescript run typecheck",
    "preview:web": "npm --workspace apps/web run preview",
    "check:metadata-gateway": "npm --prefix services/metadata-gateway run check && npm --prefix services/metadata-gateway test",
    "ci:check": "node scripts/run-powershell.mjs scripts/ci-check.ps1",
    "ga:regression": "node scripts/run-powershell.mjs scripts/run-ga-regression.ps1",
    "coverage:inventory": "node scripts/coverage-inventory.mjs",
    "validate:agents": "node scripts/run-powershell.mjs scripts/validate-agent-readiness.ps1",
    "gate": "node scripts/run-powershell.mjs scripts/gate.ps1",
    "build:icon": "node scripts/build-windows-icon.mjs",
    "mutation:web": "npm --workspace apps/web run mutation"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
