{
  "name": "deluno-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "sdk/typescript"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "test:web": "npm --workspace apps/web run test:smoke",
    "test:unit:web": "npm --workspace apps/web run test:unit",
    "typecheck:sdk": "npm --workspace sdk/typescript run typecheck",
    "preview:web": "npm --workspace apps/web run preview",
    "check:metadata-gateway": "npm --prefix services/metadata-gateway run check && npm --prefix services/metadata-gateway test",
    "ci:check": "node scripts/run-ci-check.mjs",
    "ga:regression": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/run-ga-regression.ps1",
    "coverage:inventory": "node scripts/coverage-inventory.mjs",
    "soak:snapshot": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/collect-soak-snapshot.ps1",
    "validate:agents": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-agent-readiness.ps1"
  }
}
