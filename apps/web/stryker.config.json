{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "$comment": "Mutation testing for the web app (issue 1269, docs/testing/STRATEGY.md measure 3). Run from apps/web: npm run mutation. A changed-files run adds --since in CI; scripts/check-mutation-ratchet.mjs judges the report.",
  "testRunner": "vitest",
  "vitest": { "configFile": "vite.config.ts" },
  "mutate": ["src/**/*.ts", "src/**/*.tsx", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/**/*.d.ts", "!src/test/**"],
  "coverageAnalysis": "perTest",
  "reporters": ["json", "progress", "clear-text"],
  "jsonReporter": { "fileName": "reports/mutation/web.json" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "thresholds": { "high": 100, "low": 90, "break": 0 }
}
