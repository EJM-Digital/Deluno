{
  "name": "deluno-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:smoke": "playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "mutation": "stryker run",
    "lint": "eslint src",
    "check:orphans": "knip --include files,dependencies",
    "validate:job-status": "ts-node scripts/validate-job-status.ts",
    "validate:ui-spacing": "ts-node scripts/validate-ui-spacing.ts",
    "validate:ui-primitives": "ts-node scripts/validate-ui-primitives.ts",
    "validate:ui-typography": "ts-node scripts/validate-ui-typography.ts",
    "validate:copy": "ts-node scripts/validate-copy.ts",
    "validate:live-timers": "ts-node scripts/validate-live-timers.ts",
    "prebuild": "npm run lint && npm run validate:ui-spacing && npm run validate:ui-primitives && npm run validate:job-status && npm run validate:ui-typography && npm run validate:copy && npm run validate:live-timers"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@microsoft/signalr": "^10.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-router-dom": "^7.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "4.10.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.40.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
