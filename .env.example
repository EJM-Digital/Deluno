# Copy to .env beside compose.yaml for a Docker deployment. This file is read
# by Docker Compose and is intentionally ignored by Git when named .env.
# Normal Deluno installations use the managed metadata gateway and never ask
# library users for provider credentials. These direct keys are a private
# deployment fallback only; never place them in the Deluno web interface or
# commit them to source control.
DELUNO_METADATA_PROVIDER_MODE=hybrid
DELUNO_METADATA_BROKER_URL=

# Use a versioned tag for normal upgrades, or pin this to an immutable digest
# for repeatable deployments and safe rollback.
DELUNO_IMAGE=ghcr.io/jampat000/deluno:latest
DELUNO_IMAGE_DIGEST=

# Keep this stable across container recreates. It is a base64-encoded 32-byte
# key; leave it empty only when using /data/secrets/master.key instead.
DELUNO_MASTER_KEY=

# Optional host-side path for the persistent /data bind mount.
DELUNO_DATA_DIR=./artifacts/docker/data

TMDB_API_KEY=

# Optional: required only when using MDbList import lists.
MDBLIST_API_KEY=
