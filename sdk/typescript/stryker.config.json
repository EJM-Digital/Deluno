{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for the API client (issue 1269). Its tests are node:test files, so the command runner runs them. Run from sdk/typescript: npx stryker run.",
  "testRunner": "command",
  "commandRunner": { "command": "node --test tests/delunoclient.test.mjs" },
  "mutate": ["src/**/*.ts", "!src/**/*.d.ts"],
  "coverageAnalysis": "off",
  "reporters": ["json", "progress", "clear-text"],
  "jsonReporter": { "fileName": "reports/mutation/sdk.json" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "thresholds": { "high": 100, "low": 90, "break": 0 }
}
